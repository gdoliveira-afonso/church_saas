# ============================================================
# CRM Gestão Celular SaaS — .gitignore
# ============================================================

# ----- Dependências -----
node_modules/
.npm

# ----- Banco de dados -----
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
server/prisma/dev.db*

# ----- Variáveis de Ambiente (NUNCA commitar) -----
.env
.env.local
.env.production
.env.*.local
server/.env
server/.env.local
server/.env.production

# ----- Uploads / Arquivos gerados pelos usuários -----
server/uploads/*
!server/uploads/.gitkeep

# ----- Build Frontend -----
dist/
dist-ssr/

# ----- Capacitor (plataformas nativas geradas) -----
# A pasta android/ é gerada — commitar apenas recursos customizados
android/**
!android/app/
!android/app/google-services.json
!android/app/src/
!android/app/src/main/
!android/app/src/main/res/
!android/app/src/main/res/mipmap-*/
!android/app/src/main/res/mipmap-*/ic_launcher.png
!android/app/src/main/res/mipmap-*/ic_launcher_round.png
!android/app/src/main/res/mipmap-*/ic_launcher_foreground.png
!android/app/src/main/res/mipmap-*/ic_launcher_background.png
!android/app/src/main/res/mipmap-anydpi-v26/
!android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
!android/app/src/main/res/mipmap-anydpi-v26/ic_launcher_round.xml
ios/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/logs/

# ----- Cache & Temp -----
.cache/
*.tmp
server/tmp_*.js

# ----- Ferramentas de IDE -----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ----- OS -----
.DS_Store
Thumbs.db
desktop.ini

# ----- Claude / Agentes IA -----
.claude/
.gemini/

# ----- Prisma gerado -----
server/node_modules/.prisma/

# Environment & Secrets (AIOX)
*.key
*.pem

# Dependencies (AIOX)
node_modules

# Build & Logs (AIOX)
build/
logs/

# IDE & OS (AIOX)
*.swp

# AIOX Local (AIOX)
.aiox-core/local/
.claude/settings.local.json
.aiox/install-log.txt

# Firebase service account key (credencial privada — nunca commitar)
apk/*.json

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique // ex: 'batista-central'
  subdomain           String?  @unique // ex: 'central.meusaas.com'
  customDomain        String?  @unique // ex: 'igrejacentral.org.br'
  status              String   @default("active") // active, suspended
  plan                String   @default("demo") // demo, normal
  cellsEnabled        Boolean  @default(true)   // módulo celular habilitado
  ebdEnabled          Boolean  @default(false)  // módulo EBD habilitado
  financialEnabled    Boolean  @default(false)  // módulo financeiro habilitado

  // Branding
  logoUrl             String?
  primaryColor        String   @default("#0f172a")
  loginMessage        String?
  congregationName    String?
  congregationAddress String?
  pastorName          String?
  nucleus             String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  cells               Cell[]
  generations         Generation[]
  people              Person[]
  attendances         Attendance[]
  events              Event[]
  tracks              Track[]
  forms               Form[]
  systemConfigs       SystemConfig[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  eventExceptions     EventException[]
  cellCancellations   CellCancellation[]
  cellJustifications  CellJustification[]
  personMilestones    PersonMilestone[]
  pastoralNotes       PastoralNote[]
  visits              Visit[]
  triageQueues        TriageQueue[]
  ebdClasses          EbdClass[]
  ebdOfferings        EbdOffering[]
  financialAccounts   FinancialAccount[]
  funds               Fund[]
  chartOfAccounts     ChartOfAccount[]
  financialTransactions FinancialTransaction[]
  donations           Donation[]
  donationBatches     DonationBatch[]
  bills               Bill[]
  deviceTokens        DeviceToken[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   // unique por organização — ver @@unique abaixo
  password       String
  role           String   @default("USER") // ADMIN, SUPERVISOR, LIDER_GERACAO, LEADER, SUPERADMIN
  secondaryRoles String?                   // JSON array: ["PROFESSOR","SUPERINTENDENTE_EBD"]
  avatar         String?
  generationId   String?
  organizationId String?
  tokenVersion   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  generation     Generation?    @relation(fields: [generationId], references: [id])
  notifications  Notification[]
  person         Person?
  ebdClassesProfessor        EbdClass[]   @relation("EbdClassProfessor")
  ebdClassesSegundoProfessor EbdClass[]   @relation("EbdClassSegundoProfessor")
  ebdClassesTerceiroProfessor EbdClass[]  @relation("EbdClassTerceiroProfessor")
  ebdOfferingsRegistradas    EbdOffering[] @relation("EbdOfferingRegistradoPor")
  financialTransactions      FinancialTransaction[] @relation("FinTransRegisteredBy")
  donations                  Donation[]             @relation("DonationRegisteredBy")
  donationBatches            DonationBatch[]        @relation("DonationBatchCreatedBy")
  bills                      Bill[]                 @relation("BillCreatedBy")
  billPayments               BillPayment[]          @relation("BillPaymentRegisteredBy")
  deviceTokens               DeviceToken[]

  @@index([organizationId])
  // Username único por organização (multi-tenant): mesmo username pode existir em igrejas distintas.
  // SUPERADMINs têm organizationId = null — validação de unicidade feita no app (SQLite/PG tratam NULL != NULL).
  @@unique([username, organizationId])
}

model Cell {
  id             String      @id @default(cuid())
  name           String
  leaderId       String?
  viceLeaderId   String?
  hostId         String?
  address        String?
  meetingDay     String?
  meetingTime    String?
  status         String      @default("ativa")
  generationId   String?
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  generation     Generation? @relation(fields: [generationId], references: [id])
  people         Person[]
  attendances    Attendance[]
  cellCancellations CellCancellation[]
  cellJustifications CellJustification[]

  @@index([leaderId])
  @@index([viceLeaderId])
  @@index([organizationId])
}

model Generation {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  cells          Cell[]

  @@unique([name, organizationId])
}

model Person {
  id               String   @id @default(cuid())
  name             String
  phone            String?
  email            String?
  birthdate        String?
  address          String?
  status           String   @default("Visitante")
  howKnown         String?
  previousCell     String?
  returnReason     String?
  prayerRequest    String?
  cellId           String?
  userId           String?  @unique
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  extraData        String?

  organization     Organization @relation(fields: [organizationId], references: [id])
  cell             Cell?    @relation(fields: [cellId], references: [id])
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits           Visit[]
  pastoralNotes    PastoralNote[]
  attendanceRecords AttendanceRecord[]
  personTracks     PersonTrack[]
  consolidation    Consolidation?
  milestones       PersonMilestone[]
  ebdStudents                EbdStudent[]
  donations                  Donation[]
}

model Consolidation {
  id            String    @id @default(cuid())
  personId      String    @unique
  status        String    @default("PENDING")
  startDate     DateTime  @default(now())
  completedDate DateTime?
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonMilestone {
  id             String   @id @default(cuid())
  personId       String
  organizationId String
  type           String
  label          String
  detail         String?
  icon           String?
  color          String?
  date           DateTime @default(now())

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ActivityLog {
  id             String   @id @default(cuid())
  userId         String?
  userName       String?
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  detail         String?
  ip             String?
  createdAt      DateTime @default(now())
  
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model Attendance {
  id             String   @id @default(cuid())
  cellId         String
  organizationId String
  date           String
  notes          String?
  customFields   String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  cell           Cell     @relation(fields: [cellId], references: [id])
  records        AttendanceRecord[]

  @@unique([cellId, date])
  @@index([organizationId])
  @@index([cellId, date])
}

model AttendanceRecord {
  id           String     @id @default(cuid())
  attendanceId String
  personId     String
  status       String

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, personId])
}

model PastoralNote {
  id             String   @id @default(cuid())
  personId       String
  organizationId String
  date           String
  type           String?
  text           String
  authorId       String
  createdAt      DateTime @default(now())

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Visit {
  id             String   @id @default(cuid())
  personId       String
  organizationId String
  date           String
  type           String
  notes          String?
  authorId       String
  createdAt      DateTime @default(now())

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Event {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  date           String
  startTime      String?
  endTime        String?
  description    String?
  color          String   @default("blue")
  type           String?  @default("event")
  category       String?
  location       String?
  icon           String?
  recurrence     String?
  reminder       String?
  notify         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  exceptions     EventException[]

  @@index([organizationId])
  @@index([date])
}

model EventException {
  id             String   @id @default(cuid())
  eventId        String
  organizationId String
  date           String
  canceled       Boolean  @default(false)
  newTitle       String?

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([eventId, date])
}

model CellCancellation {
  id             String   @id @default(cuid())
  cellId         String
  organizationId String
  date           String
  reason         String?
  authorId       String

  cell           Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([cellId, date])
  @@index([organizationId])
  @@index([date])
}

model CellJustification {
  id             String   @id @default(cuid())
  cellId         String
  organizationId String
  date           String
  reason         String
  authorId       String

  cell           Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Track {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  category       String
  icon           String?
  color          String?
  targetMetadata String?
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  personTracks   PersonTrack[]
}

model PersonTrack {
  id        String   @id @default(cuid())
  personId  String
  trackId   String
  completed Boolean  @default(true)
  date      DateTime @default(now())

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([personId, trackId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  title          String
  message        String
  action         String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Form {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  status         String   @default("ativo")
  showOnLogin    Boolean  @default(false)
  icon           String?  @default("description")
  color          String?  @default("blue")
  subtitle       String?
  personStatus   String?
  fields         String

  organization   Organization @relation(fields: [organizationId], references: [id])
  triage         TriageQueue[]
}

model TriageQueue {
  id             String   @id @default(cuid())
  formId         String
  organizationId String
  data           String
  status         String   @default("new")
  createdAt      DateTime @default(now())

  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model SystemConfig {
  key            String
  value          String
  organizationId String
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  @@id([key, organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  permissions    String    @default("read_membros,read_eventos")
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Webhook {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  url            String
  secret         String
  events         String
  status         String             @default("active")
  createdAt      DateTime           @default(now())

  organization   Organization       @relation(fields: [organizationId], references: [id])
  logs           WebhookLog[]
  deliveries     WebhookDelivery[]
}

model WebhookLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  statusCode   Int?
  responseTime Int?
  success      Boolean  @default(false)
  createdAt    DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  organizationId String
  event          String
  payload        String   // JSON stringificado
  attempts       Int      @default(0)
  nextRetryAt    DateTime
  lastStatusCode Int?
  lastError      String?
  status         String   @default("pending") // pending | delivered | failed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  webhook        Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model EbdClass {
  id                   String   @id @default(cuid())
  organizationId       String
  name                 String
  faixaEtaria          String?
  sala                 String?
  professorId          String?
  segundoProfessorId   String?
  terceiroProfessorId  String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id])
  professor            User?        @relation("EbdClassProfessor", fields: [professorId], references: [id])
  segundoProfessor     User?        @relation("EbdClassSegundoProfessor", fields: [segundoProfessorId], references: [id])
  terceiroProfessor    User?        @relation("EbdClassTerceiroProfessor", fields: [terceiroProfessorId], references: [id])
  students             EbdStudent[]
  attendances          EbdAttendance[]
  offerings            EbdOffering[]

  @@unique([name, organizationId])
}

model EbdStudent {
  id             String   @id @default(cuid())
  personId       String
  ebdClassId     String
  dataMatricula  DateTime @default(now())
  ativo          Boolean  @default(true)

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  ebdClass       EbdClass @relation(fields: [ebdClassId], references: [id], onDelete: Cascade)
  attendanceRecords EbdAttendanceRecord[]

  @@unique([personId, ebdClassId])
}

model EbdAttendance {
  id          String   @id @default(cuid())
  ebdClassId  String
  data        String
  notes       String?
  professorPresente        Boolean @default(false)
  professorJustificado      Boolean @default(false)
  segundoProfessorPresente Boolean @default(false)
  segundoProfessorJustificado Boolean @default(false)
  terceiroProfessorPresente Boolean @default(false)
  terceiroProfessorJustificado Boolean @default(false)
  createdAt   DateTime @default(now())

  ebdClass    EbdClass  @relation(fields: [ebdClassId], references: [id], onDelete: Cascade)
  records     EbdAttendanceRecord[]

  @@unique([ebdClassId, data])
}

model EbdAttendanceRecord {
  id               String        @id @default(cuid())
  ebdAttendanceId  String
  ebdStudentId     String
  presente         Boolean       @default(false)
  justificado      Boolean       @default(false)

  ebdAttendance    EbdAttendance @relation(fields: [ebdAttendanceId], references: [id], onDelete: Cascade)
  ebdStudent       EbdStudent    @relation(fields: [ebdStudentId], references: [id], onDelete: Cascade)

  @@unique([ebdAttendanceId, ebdStudentId])
}

model EbdOffering {
  id              String   @id @default(cuid())
  ebdClassId      String
  organizationId  String
  data            String
  valor           Float
  observacao      String?
  registradoPorId String
  createdAt       DateTime @default(now())

  ebdClass        EbdClass     @relation(fields: [ebdClassId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id])
  registradoPor   User         @relation("EbdOfferingRegistradoPor", fields: [registradoPorId], references: [id])
}

model FinancialAccount {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  type           String    @default("CAIXA")   // CAIXA | CONTA_CORRENTE | POUPANCA | PIX | OUTRO
  bank           String?
  agency         String?
  accountNumber  String?
  initialBalance Int       @default(0)          // Em centavos
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization          @relation(fields: [organizationId], references: [id])
  transactions   FinancialTransaction[]

  @@index([organizationId])
}

model Fund {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  color          String?   @default("blue")
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id])
  transactions   FinancialTransaction[]
  donations      Donation[]

  @@unique([name, organizationId])
  @@index([organizationId])
}

model ChartOfAccount {
  id             String    @id @default(cuid())
  organizationId String
  code           String?
  name           String
  type           String                          // RECEITA | DESPESA
  parentId       String?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization   Organization          @relation(fields: [organizationId], references: [id])
  parent         ChartOfAccount?       @relation("ChartParent", fields: [parentId], references: [id])
  children       ChartOfAccount[]      @relation("ChartParent")
  transactions   FinancialTransaction[]
  bills          Bill[]

  @@unique([code, organizationId])
  @@index([organizationId])
}

model FinancialTransaction {
  id              String    @id @default(cuid())
  organizationId  String
  accountId       String
  chartAccountId  String?
  fundId          String?
  type            String                          // RECEITA | DESPESA
  description     String
  amount          Int                             // Em centavos (sempre positivo)
  date            String                          // "YYYY-MM-DD"
  competenceDate  String?
  paymentMethod   String?
  referenceType   String?                         // "BILL" | "DONATION" | "MANUAL"
  notes           String?
  registeredById  String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id])
  account         FinancialAccount @relation(fields: [accountId], references: [id])
  chartAccount    ChartOfAccount?  @relation(fields: [chartAccountId], references: [id])
  fund            Fund?            @relation(fields: [fundId], references: [id])
  registeredBy    User             @relation("FinTransRegisteredBy", fields: [registeredById], references: [id])

  @@index([organizationId])
  @@index([accountId])
  @@index([date])
  @@index([type])
  @@index([amount])
  // DB-003: índices compostos para queries financeiras comuns
  @@index([organizationId, date, type])
  @@index([accountId, date])
  @@index([organizationId, deletedAt, date])
}

model Donation {
  id              String    @id @default(cuid())
  organizationId  String
  personId        String?
  batchId         String?
  type            String    @default("DIZIMO")   // DIZIMO | OFERTA | OFERTA_ESPECIAL | PRIMICIA | OUTRO
  amount          Int                             // Em centavos
  date            String                          // "YYYY-MM-DD"
  fundId          String?
  paymentMethod   String?
  notes           String?
  visitorName     String?
  transactionId   String?   @unique
  registeredById  String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization    Organization      @relation(fields: [organizationId], references: [id])
  person          Person?           @relation(fields: [personId], references: [id])
  batch           DonationBatch?    @relation(fields: [batchId], references: [id])
  fund            Fund?             @relation(fields: [fundId], references: [id])
  registeredBy    User              @relation("DonationRegisteredBy", fields: [registeredById], references: [id])

  @@index([organizationId])
  @@index([personId])
  @@index([date])
  @@index([amount])
  // DB-003: índices compostos para relatórios de doações
  @@index([organizationId, date, type])
  @@index([personId, organizationId])
}

model DonationBatch {
  id              String    @id @default(cuid())
  organizationId  String
  name            String
  date            String                          // "YYYY-MM-DD"
  totalAmount     Int       @default(0)
  notes           String?
  createdById     String
  createdAt       DateTime  @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id])
  createdBy       User         @relation("DonationBatchCreatedBy", fields: [createdById], references: [id])
  donations       Donation[]

  @@index([organizationId])
}

model Bill {
  id              String    @id @default(cuid())
  organizationId  String
  chartAccountId  String?
  description     String
  supplier        String?
  amount          Int                             // Em centavos
  dueDate         String                          // "YYYY-MM-DD"
  competenceDate  String?
  status          String    @default("PENDENTE")  // PENDENTE | PAGO | CANCELADO
  recurrence      String?                         // NONE | MONTHLY | YEARLY
  notes           String?
  createdById     String
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id])
  chartAccount    ChartOfAccount? @relation(fields: [chartAccountId], references: [id])
  createdBy       User            @relation("BillCreatedBy", fields: [createdById], references: [id])
  payments        BillPayment[]

  @@index([organizationId])
  @@index([dueDate])
  @@index([status])
  // DB-003: índice composto para listar pendentes/vencidas por org
  @@index([organizationId, status, dueDate])
}

model BillPayment {
  id              String    @id @default(cuid())
  billId          String
  amount          Int                             // Em centavos
  paymentDate     String                          // "YYYY-MM-DD"
  paymentMethod   String?
  accountId       String?
  transactionId   String?   @unique
  notes           String?
  registeredById  String
  createdAt       DateTime  @default(now())

  bill            Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  registeredBy    User   @relation("BillPaymentRegisteredBy", fields: [registeredById], references: [id])

  @@index([billId])
}

model DeviceToken {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  token          String
  platform       String   @default("android") // android | ios
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@index([organizationId])
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Para usar PostgreSQL: troque provider para "postgresql"
  // e atualize DATABASE_URL no .env com a connection string do Postgres.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique // ex: 'batista-central'
  subdomain           String?  @unique // ex: 'central.meusaas.com'
  customDomain        String?  @unique // ex: 'igrejacentral.org.br'
  status              String   @default("active") // active, suspended
  plan                String   @default("BASIC") // BASIC, PRO, ENTERPRISE
  
  // Branding
  logoUrl             String?
  primaryColor        String   @default("#0f172a")
  loginMessage        String?
  congregationName    String?
  congregationAddress String?
  pastorName          String?
  nucleus             String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  cells               Cell[]
  generations         Generation[]
  people              Person[]
  attendances         Attendance[]
  events              Event[]
  tracks              Track[]
  forms               Form[]
  systemConfigs       SystemConfig[]
  apiKeys             ApiKey[]
  webhooks            Webhook[]
  notifications       Notification[]
  activityLogs        ActivityLog[]
  eventExceptions     EventException[]
  cellCancellations   CellCancellation[]
  cellJustifications  CellJustification[]
  personMilestones    PersonMilestone[]
  pastoralNotes       PastoralNote[]
  visits              Visit[]
  triageQueues        TriageQueue[]
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  password       String
  role           String   @default("USER") // ADMIN, SUPERVISOR, LIDER_GERACAO, LEADER, SUPERADMIN
  avatar         String?
  generationId   String?
  organizationId String?
  tokenVersion   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id])
  generation     Generation?    @relation(fields: [generationId], references: [id])
  notifications  Notification[]
  person         Person?
}

model Cell {
  id             String      @id @default(cuid())
  name           String
  leaderId       String?
  viceLeaderId   String?
  hostId         String?
  address        String?
  meetingDay     String?
  meetingTime    String?
  status         String      @default("ativa")
  generationId   String?
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  generation     Generation? @relation(fields: [generationId], references: [id])
  people         Person[]
  attendances    Attendance[]
  cellCancellations CellCancellation[]
  cellJustifications CellJustification[]
}

model Generation {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  users          User[]
  cells          Cell[]

  @@unique([name, organizationId])
}

model Person {
  id               String   @id @default(cuid())
  name             String
  phone            String?
  email            String?
  birthdate        String?
  address          String?
  status           String   @default("Visitante")
  howKnown         String?
  previousCell     String?
  returnReason     String?
  prayerRequest    String?
  cellId           String?
  userId           String?  @unique
  organizationId   String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  extraData        String?

  organization     Organization @relation(fields: [organizationId], references: [id])
  cell             Cell?    @relation(fields: [cellId], references: [id])
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  visits           Visit[]
  pastoralNotes    PastoralNote[]
  attendanceRecords AttendanceRecord[]
  personTracks     PersonTrack[]
  consolidation    Consolidation?
  milestones       PersonMilestone[]
}

model Consolidation {
  id            String    @id @default(cuid())
  personId      String    @unique
  status        String    @default("PENDING")
  startDate     DateTime  @default(now())
  completedDate DateTime?
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model PersonMilestone {
  id             String   @id @default(cuid())
  personId       String
  organizationId String
  type           String
  label          String
  detail         String?
  icon           String?
  color          String?
  date           DateTime @default(now())

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model ActivityLog {
  id             String   @id @default(cuid())
  userId         String?
  userName       String?
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  detail         String?
  ip             String?
  createdAt      DateTime @default(now())
  
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Attendance {
  id             String   @id @default(cuid())
  cellId         String
  organizationId String
  date           String
  notes          String?
  customFields   String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  cell           Cell     @relation(fields: [cellId], references: [id])
  records        AttendanceRecord[]

  @@unique([cellId, date])
}

model AttendanceRecord {
  id           String     @id @default(cuid())
  attendanceId String
  personId     String
  status       String

  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, personId])
}

model PastoralNote {
  id             String   @id @default(cuid())
  personId       String
  organizationId String
  date           String
  type           String?
  text           String
  authorId       String
  createdAt      DateTime @default(now())

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Visit {
  id             String   @id @default(cuid())
  personId       String
  organizationId String
  date           String
  type           String
  notes          String?
  authorId       String
  createdAt      DateTime @default(now())

  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Event {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  date           String
  startTime      String?
  endTime        String?
  description    String?
  color          String   @default("blue")
  type           String?  @default("event")
  category       String?
  location       String?
  icon           String?
  recurrence     String?
  reminder       String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  exceptions     EventException[]
}

model EventException {
  id             String   @id @default(cuid())
  eventId        String
  organizationId String
  date           String
  canceled       Boolean  @default(false)
  newTitle       String?

  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([eventId, date])
}

model CellCancellation {
  id             String   @id @default(cuid())
  cellId         String
  organizationId String
  date           String
  reason         String?
  authorId       String

  cell           Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([cellId, date])
}

model CellJustification {
  id             String   @id @default(cuid())
  cellId         String
  organizationId String
  date           String
  reason         String
  authorId       String

  cell           Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Track {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  category       String
  icon           String?
  color          String?
  targetMetadata String?
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  personTracks   PersonTrack[]
}

model PersonTrack {
  id        String   @id @default(cuid())
  personId  String
  trackId   String
  completed Boolean  @default(true)
  date      DateTime @default(now())

  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([personId, trackId])
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  title          String
  message        String
  action         String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Form {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  status         String   @default("ativo")
  showOnLogin    Boolean  @default(false)
  icon           String?  @default("description")
  color          String?  @default("blue")
  subtitle       String?
  personStatus   String?
  fields         String

  organization   Organization @relation(fields: [organizationId], references: [id])
  triage         TriageQueue[]
}

model TriageQueue {
  id             String   @id @default(cuid())
  formId         String
  organizationId String
  data           String
  status         String   @default("new")
  createdAt      DateTime @default(now())

  form           Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model SystemConfig {
  key            String
  value          String
  organizationId String
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  @@id([key, organizationId])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  permissions    String    @default("read_membros,read_eventos")
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Webhook {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  url            String
  secret         String
  events         String
  status         String       @default("active")
  createdAt      DateTime     @default(now())
  
  organization   Organization @relation(fields: [organizationId], references: [id])
  logs           WebhookLog[]
}

model WebhookLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  statusCode   Int?
  responseTime Int?
  success      Boolean  @default(false)
  createdAt    DateTime @default(now())
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}


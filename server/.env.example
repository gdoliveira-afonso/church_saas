# ============================================================
# CRM Gestão Celular SaaS — Variáveis de Ambiente (Backend)
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env real no repositório.

# --- Servidor ---
NODE_ENV=production
PORT=3000

# --- Segurança JWT ---
# Gere com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_muito_segura_aqui

# --- Banco de Dados ---
# SQLite (padrão, desenvolvimento e produção leve):
DATABASE_URL="file:./dev.db"

# PostgreSQL (produção recomendada):
# DATABASE_URL="postgresql://crm:crm_password@localhost:5432/church_crm?schema=public"

# --- SaaS Multi-Tenant ---
# Domínio base da plataforma. Ex: se igrejas acessam por igreja1.saas.com.br, coloque saas.com.br
# Deixe vazio em desenvolvimento local.
SAAS_DOMAIN=

# --- Credenciais iniciais do Superadmin (gerado no primeiro boot se não existir) ---
# ATENÇÃO: Troque a senha imediatamente após o primeiro login!
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=troque_imediatamente

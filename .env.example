# ============================================================
# CRM Gestão Celular SaaS — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o .env real no repositório.
# Este arquivo é lido pelo docker-compose.yml e pelo install.sh.

# --- Segurança JWT ---
# Gere uma chave segura com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_muito_segura_aqui

# --- Banco de Dados (PostgreSQL — padrão de produção) ---
DATABASE_URL="postgresql://crm:crm_password@postgres:5432/church_crm?schema=public"

# Desenvolvimento local com SQLite (troque também o provider no schema.prisma):
# DATABASE_URL="file:./dev.db"

# --- SaaS Multi-Tenant ---
# Domínio base da plataforma. Ex: se igrejas acessam por igreja1.saas.com.br, coloque saas.com.br
# Deixe vazio em desenvolvimento local.
SAAS_DOMAIN=

# --- Superadmin Initial Credentials ---
# Criado no primeiro boot se não existir nenhum SUPERADMIN no banco.
# ATENÇÃO: Troque a senha imediatamente após o primeiro login!
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=troque_imediatamente

# --- PostgreSQL (credenciais do container Docker) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=church_crm
